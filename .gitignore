# Constituents (checked-out repos and symlinked folders) are listed on
# the dashboard, not tracked here. Each checkout has its own history.
/jailbreak-kindle

# Workspace metadata: keep skills and artifacts, drop the rest
# (task logs carry live tokens).
.cptr/*
!.cptr/skills/
!.cptr/artifacts/

# Built here. The Kindle binary `xcom` is committed so install does not
# need the cross compiler. The PC test binary is not.
/xcom-host
/chess-host
/tetris-host
/menu-host
/sudoku-host
/rockman-host
*:Zone.Identifier
*.pgm
/tetris-open.png
/tetris-play.png
# Board dumps pulled from the device for a look; regenerate any time.
/chess-live.*
# Panel shot pulled by fb-shot.sh; regenerate any time.
/kindle-now.png

# The file with the real API key in it. The example is tracked instead.
/chess.conf


# Python bytecode from the tools
__pycache__/

# Generated audio (baked by make manual / make_manual_audio.py)
*.wav
/pvz-host
/pvz

# Pipes: same as pvz -- the cross build and the PC test binary are products,
# and the screenshots come back from `make pipes-test` any time.
/pipes
/pipes-host
/pipes-*.png

# Brogue: the vendored upstream source tree keeps its own git history, like
# the jailbreak-kindle constituent, so it is not tracked here. Build outputs
# and PC test binaries are ignored too; the port code itself (the kfb
# platform files inside brogue/) lives in that tree's own commits.
/brogue/
/build/
/brogue-host
/brogue-kindle-app
/calib
/calib-host
/echo-probe
/previews/

# host-side engine contract check binary
engine-test
