# Constituents (checked-out repos and symlinked folders) are listed on
# the dashboard, not tracked here. Each checkout has its own history.
/jailbreak-kindle

# Workspace metadata: keep skills and artifacts, drop the rest
# (task logs carry live tokens).
.cptr/*
!.cptr/skills/
!.cptr/artifacts/

# Built here. The Kindle binary `xcom` is committed so install does not
# need the cross compiler. The PC test binary is not.
/xcom-host
/chess-host
*:Zone.Identifier
*.pgm

# The file with the real API key in it. The example is tracked instead.
/chess.conf


# Python bytecode from the tools
__pycache__/

# Generated audio (baked by make manual / make_manual_audio.py)
*.wav
